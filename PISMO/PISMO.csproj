<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PISMO</AssemblyName>
    <RootNamespace>PISMO</RootNamespace>
    <ApplicationIcon>pismo.ico</ApplicationIcon>
    <StartupObject>PISMO.Program</StartupObject>
    <Version>1.8.1</Version>
    <AssemblyVersion>1.8.1.0</AssemblyVersion>
    <FileVersion>1.8.1.0</FileVersion>
    <Company>PISMO</Company>
    <Product>PISMO Messenger</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Иконка копируется рядом с exe, чтобы подхватывать её в рантайме
         (трей, формы) и использовать в инсталляторе. -->
    <None Update="pismo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AForge" Version="2.2.5" />
    <PackageReference Include="AForge.Video" Version="2.2.5" />
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="MySql.Data" Version="9.7.0" />

    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <!-- ip.txt копируется в output directory -->
  <ItemGroup>
    <None Update="ip.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Локальный RNNoise (офлайн): папка noise рядом с exe, отдаётся через
       virtual host pismo-noise.local. Решает блокировку CDN и несовместимость
       версий esm/wasm/worklet. -->
  <ItemGroup>
    <None Include="noise\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>noise\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <!-- Отключает автоматическую подстановку EmbeddedResource SDK'ом -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="CallForm.resx" />
    <EmbeddedResource Include="LoginForm.resx" />
    <EmbeddedResource Include="MainForm_MessageActions.resx" />
    <EmbeddedResource Include="SettingsForm.resx" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="CallForm - Копировать.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>

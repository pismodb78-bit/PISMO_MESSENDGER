  <!-- БАРЬЕР. MSBuild ищет Directory.Build.props вверх по дереву папок и берёт
       ПЕРВЫЙ найденный, затем останавливается. Этот файл перехватывает поиск на
       уровне репозитория, чтобы проект НЕ наследовал случайный
       Directory.Build.props из родительских папок пользователя (например,
       добавляющий запрещённую прямую ссылку на Microsoft.Web.WebView2.Core.winmd
       -> ошибка NETSDK1130). Родительский НЕ импортируем намеренно. Пусто. -->
</Project>
